<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>JKON - Audioguide</title>
    <link>https://jkon.ch</link>
    <language>de-ch</language>
    <copyright>&#169; JKON</copyright>
    <itunes:author>JKON - Junge Kunst Olten</itunes:author>
    <description>Audioguide für die Ausstellungen der Jungen Kunst Olten (JKON)</description>
    <itunes:type>serial</itunes:type>
    <itunes:image href="https://jkon.ch/images/jkon-logo-plain.png" />
    <itunes:category text="Arts" />
    <itunes:explicit>false</itunes:explicit>
    <lastBuildDate><%= Time.now.rfc2822 %></lastBuildDate>
    <generator>generate_feed.rb</generator>
    <itunes:owner>
        <itunes:name>JKON - Junge Kunst Olten</itunes:name>
        <itunes:email>info@jkon.ch</itunes:email>
    </itunes:owner>

    <% episodes.each do |episode| %>
      <item>
        <title><%= CGI.escapeHTML(episode.title) %></title>
        <link><%= episode.link %></link>
        <itunes:episodeType>full</itunes:episodeType>
        <itunes:title><%= CGI.escapeHTML(episode.title) %></itunes:title>
        <description><%= CGI.escapeHTML(episode.description) %></description>
        <enclosure length="<%= episode.size %>" type="audio/mpeg"
          url="<%= episode.url %>" />
        <guid><%= episode.uuid %></guid>
        <pubDate><%= episode.publish_time.rfc2822 %></pubDate>
        <itunes:duration><%= episode.duration %></itunes:duration>
        <itunes:explicit>false</itunes:explicit>
        <itunes:episode><%= episode.number %></itunes:episode>
        <itunes:season><%= episode.season %></itunes:season>
      </item>
    <% end %>
  </channel>
</rss>
